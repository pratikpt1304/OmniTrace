# FalkorDB Connection (Local Docker or FalkorDB Cloud)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH=omnitrace_fraud_mesh

# Server Network Configuration
HOST=127.0.0.1
PORT=8765
ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# AI Agent Configuration ('rules' mode works 100% offline without LLM keys)
AGENT_MODE=rules
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Governance & Security
AUTO_FREEZE=false
OMNITRACE_API_KEY=
